{
	"name": "josephscott/stratomatta",
	"license": "MIT",
	"require": {
		"php": ">=8.2",
		"ext-event": "^3.1.3",
		"workerman/workerman": "^5.0.0-rc.3",
		"nikic/fast-route": "^1.3.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.65",
		"josephscott/phpcsfixer-config": "^0.0.3",
		"phpstan/phpstan": "^2.0",
		"pestphp/pest": "^3.7.1",
		"josephscott/amulet": "^0.0.2"
	},
	"autoload": {
		"classmap": [
			"src/josephscott/stratomatta/app.php"
		]
	},
	"config": {
		"classmap-authoritative": true,
		"optimize-autoloader": true,
		"allow-plugins": false
	}
}
